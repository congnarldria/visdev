* 只在矩形 ROI 裡做分割
Vizion.read_image (Image, 'samples/parts.png')
Vizion.rgb1_to_gray (Image, Gray)
Vizion.gen_rectangle1 (ROI, 60, 40, 200, 320)
Vizion.reduce_domain (Gray, ROI, Reduced)
Vizion.threshold (Reduced, Region, 60, 255)
Vizion.connection (Region, Parts)
Vizion.select_shape (Parts, Selected, 'area', 'and', 200, 999999)
Vizion.count_obj (Selected, Count)
Vizion.dev_display (Reduced)
Vizion.dev_set_color ('cyan')
Vizion.dev_set_draw ('margin')
Vizion.dev_set_line_width (2)
Vizion.dev_display (ROI)
Vizion.dev_set_color ('yellow')
Vizion.dev_display (Selected)
