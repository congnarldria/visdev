* 亮斑檢測：HALCON 區間門檻後用八連通拆開，每個物件一種顏色
Vizion.read_image (Image, 'samples/parts.png')
Vizion.rgb1_to_gray (Image, Gray)
Vizion.gauss_image (Gray, Smooth, 3)
Vizion.threshold (Smooth, Region, 60, 255)
Vizion.connection (Region, Parts)
Vizion.select_shape (Parts, Big, 'area', 'and', 400, 999999)
Vizion.select_shape (Big, RoundOnes, 'circularity', 'and', 0.82, 1)
Vizion.area_center (RoundOnes, Area, Row, Column)
Vizion.smallest_rectangle2 (RoundOnes, RectRow, RectCol, Phi, Len1, Len2)
Vizion.count_obj (RoundOnes, Count)
Vizion.intensity (RoundOnes, Gray, MeanGray, Deviation)
Label := 'Count = ' + Count
Vizion.dev_display (Gray)
Vizion.dev_set_draw ('margin')
Vizion.dev_set_line_width (2)
Vizion.dev_display (RoundOnes)
Vizion.dev_set_color ('red')
Vizion.gen_cross_contour_xld (Cross, Row, Column, 16, 0)
Vizion.dev_display (Cross)
Vizion.dev_set_color ('white')
Vizion.dev_disp_text (Label, 28, 12)
