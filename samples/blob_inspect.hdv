* 亮斑檢測：HALCON 區間門檻後用八連通拆開，每個物件一種顏色
read_image (Image, 'samples/parts.png')
rgb1_to_gray (Image, Gray)
gauss_image (Gray, Smooth, 3)
threshold (Smooth, Region, 60, 255)
connection (Region, Parts)
select_shape (Parts, Big, 'area', 'and', 400, 999999)
select_shape (Big, RoundOnes, 'circularity', 'and', 0.82, 1)
area_center (RoundOnes, Area, Row, Column)
smallest_rectangle2 (RoundOnes, RectRow, RectCol, Phi, Len1, Len2)
count_obj (RoundOnes, Count)
intensity (RoundOnes, Gray, MeanGray, Deviation)
Label := 'Count = ' + Count
dev_display (Gray)
dev_set_draw ('margin')
dev_set_line_width (2)
dev_display (RoundOnes)
dev_set_color ('red')
gen_cross_contour_xld (Cross, Row, Column, 16, 0)
dev_display (Cross)
dev_set_color ('white')
dev_disp_text (Label, 28, 12)
