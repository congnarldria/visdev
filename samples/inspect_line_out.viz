* 產線輸出。打開就能跑。規則和產線相同，合格 3、不合格 2。
* 每一張送一行 VISDEV,OK 或 NG,合格張數,不合格張數,檔名。
* 圖形視窗先選 TCP、序列埠或 Modbus，再填出現的欄位。改完按執行。
* 預設是 TCP loopback。Wire 是讀回來的 5 行，每行 24 個位元組。
* 序列埠預設名稱是 loopback，不開真的 COM。Windows 開 COM 的方式沒有改。
* Modbus 把這一張的判定寫進位址再讀回。沒有裝置時這一種會連不上。
* 這支用 File，不開相機。
Vizion.file_exists ('workspace/line_ng', NgDir)
if (NgDir == 1)
    Vizion.list_files ('workspace/line_ng', 'files', OldNg)
    Vizion.tuple_length (OldNg, OldCount)
    for OldIndex := 1 to OldCount by 1
        Vizion.delete_file (OldNg[OldIndex])
    endfor
endif
OkCount := 0
NgCount := 0
LastNg := ''
CsvFile := 'workspace/line_out.csv'
OutKind := 'tcp'
OutHost := 'loopback'
OutPort := 0
OutCom := 'loopback'
OutAddr := 16
if (OutKind == 'tcp')
    Vizion.open_socket_connect (OutHost, OutPort, Link)
else
    if (OutKind == 'serial')
        Vizion.open_serial (OutCom, Link)
    endif
endif
Vizion.open_framegrabber ('File', 'samples/line_batch', 'gray', 0, 0, Acq)
Vizion.get_framegrabber_param (Acq, 'image_count', Total)
Vizion.open_file (CsvFile, 'output', Report)
Vizion.fwrite_string (Report, 'index,file,judge,count')
Vizion.fnew_line (Report)
for Index := 1 to Total by 1
    Vizion.grab_image (Image, Acq)
    Vizion.get_framegrabber_param (Acq, 'image_name', Name)
    Vizion.threshold (Image, Region, 128, 255)
    Vizion.connection (Region, Parts, 1)
    Vizion.select_shape (Parts, Kept, 'area', 'and', 200, 99999)
    Vizion.count_obj (Kept, Count)
    if (Count >= 1)
        Judge := 'OK'
        OkCount := OkCount + 1
    else
        Judge := 'NG'
        NgCount := NgCount + 1
        LastNg := Name
        Vizion.write_image (Image, 'workspace/line_ng/' + Name)
    endif
    if (OutKind == 'modbus')
        Vizion.write_modbus_judge (OutHost, OutPort, OutAddr, Judge, Register)
    else
        Vizion.send_line_result (Link, Judge, OkCount, NgCount, Name)
    endif
    Row := Index + ',' + Name + ',' + Judge + ',' + Count
    Vizion.fwrite_string (Report, Row)
    Vizion.fnew_line (Report)
    Vizion.dev_display (Image)
    if (Count >= 1)
        Vizion.dev_set_color ('green')
    else
        Vizion.dev_set_color ('red')
    endif
    Vizion.dev_display (Kept)
endfor
if (NgCount == 0 and LastNg == '')
    Judge := '合格'
else
    Judge := '不合格'
endif
if (OutKind == 'tcp')
    Vizion.receive_data (Link, 120, Wire)
    Vizion.close_socket (Link)
else
    if (OutKind == 'serial')
        Vizion.read_serial (Link, 120, Wire)
        Vizion.close_serial (Link)
    endif
endif
Vizion.close_file (Report)
Vizion.close_framegrabber (Acq)
