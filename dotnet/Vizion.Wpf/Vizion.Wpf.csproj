<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net48;net8.0-windows</TargetFrameworks>
    <LangVersion>12.0</LangVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Vizion.Wpf</RootNamespace>
    <AssemblyName>Vizion.Wpf</AssemblyName>
    <Description>WPF 顯示控制項。Windows 7 SP1 用 .NET Framework 4.8。不使用 HWND 夾層，只畫可見範圍。</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Vizion.Display\Vizion.Display.csproj" />
  </ItemGroup>
</Project>
