<Application x:Class="Photonix.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
  <Application.Resources>
    <SolidColorBrush x:Key="WindowBackground" Color="#14171C"/>
    <SolidColorBrush x:Key="PanelBackground" Color="#1C2128"/>
    <SolidColorBrush x:Key="Ink" Color="#E6EDF3"/>
    <SolidColorBrush x:Key="Muted" Color="#8B949E"/>
    <SolidColorBrush x:Key="Line" Color="#2D333B"/>
    <SolidColorBrush x:Key="Accent" Color="#3D8BFD"/>
  </Application.Resources>
</Application>
